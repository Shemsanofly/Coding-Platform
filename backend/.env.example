SECRET_KEY=replace_me

DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# Development: leave DATABASE_URL empty to use SQLite at backend/db.sqlite3.
# Production: set DATABASE_URL to your PostgreSQL connection string.
DATABASE_URL=
# DATABASE_URL=postgresql://user:password@localhost:5432/learncode
# Optional custom SQLite path for local development only.
# DATABASE_PATH=C:\absolute\path\to\db.sqlite3
# Optional persistent DB connections for production, in seconds.
DATABASE_CONN_MAX_AGE=0

GEMINI_API_KEY=replace_with_your_gemini_key
GEMINI_MODEL=gemini-3.5-flash

ADMIN_REGISTRATION_CODE=Admin2026

AI_GENERATION_MODE=manual
AI_GENERATION_SYNC_FALLBACK=False

CELERY_BROKER_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public frontend route used in certificate PDF QR codes.
CERTIFICATE_VERIFY_BASE_URL=http://localhost:5173/verify-certificate
CERTIFICATE_PLATFORM_NAME=LearnCode
CERTIFICATE_PLATFORM_WEBSITE=http://localhost:5173
CERTIFICATE_CEO_NAME=Shemsa Amin
CERTIFICATE_CEO_TITLE=Chief Executive Officer
# Replace these with production assets when available.
# CERTIFICATE_LOGO_PATH=/absolute/path/to/learncode-logo.png
# CERTIFICATE_CEO_SIGNATURE_PATH=/absolute/path/to/ceo-signature.png
